# --- Application ---
APP_NAME="Finance Friend API"
ENVIRONMENT=development          # development | test | production
DEBUG=false

# --- Database (async driver required) ---
# Format: mysql+aiomysql://<user>:<password>@<host>:<port>/<database>?charset=utf8mb4
DATABASE_URL=mysql+aiomysql://finance_user:change-me@localhost:3306/finance_app?charset=utf8mb4

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- App client credentials (POST /api/v1/auth/token) ---
API_CLIENT_ID=finance-mobile-app
API_CLIENT_SECRET=
CLIENT_TOKEN_EXPIRE_MINUTES=60

# --- OTP ---
OTP_PROVIDER=fixed               # fixed (MVP). Real providers plug in later.
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_WINDOW=5      # per mobile, per window
OTP_SEND_WINDOW_SECONDS=3600

# --- Providers ---
CREDIT_PROVIDER=dummy            # dummy (MVP). Later: cibil

# --- CORS (comma separated) ---
CORS_ORIGINS=*
